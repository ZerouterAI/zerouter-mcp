{
  "name": "zerouter-mcp",
  "version": "0.1.0",
  "description": "AI API gateway MCP for Claude, GPT, Gemini, Grok and Kimi via Zerouter. One API key to chat, compare models, and look up API pricing.",
  "mcpName": "io.github.ZerouterAI/zerouter-mcp",
  "type": "module",
  "bin": {
    "zerouter-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "start": "node dist/index.js",
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm run build",
    "bundle": "bash scripts/build-mcpb.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "zerouter",
    "ai-api",
    "ai-api-gateway",
    "api-gateway",
    "ai-gateway",
    "openai-compatible",
    "one-api-key",
    "api-pricing",
    "claude",
    "gpt",
    "gemini",
    "codex",
    "grok",
    "kimi",
    "openai",
    "routing",
    "claude-code",
    "cursor"
  ],
  "homepage": "https://www.zerouter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZerouterAI/zerouter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ZerouterAI/zerouter-mcp/issues"
  },
  "author": "Zerouter (https://www.zerouter.ai)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0"
  }
}
